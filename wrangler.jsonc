{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "prod",
    "PUBLIC_URL": "https://cloud-agent.aflow.workers.dev",
    "MODEL_UPSTREAM_BASE": "https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1",
    "DEFAULT_MODEL": "qwen3.8-flash",
    "DEFAULT_MAX_MODEL_TOKENS": "5000000",
    // attempts 台账 cost_weighted_tokens 的隐式缓存折扣系数(横向比较用的估计值,
    // 真实折扣以百炼控制台为准)。未设/非法值回落代码里的 0.2,不影响主流程。
    "CACHE_READ_COST_FACTOR": "0.2",
    "DEFAULT_MAX_WALL_SECONDS": "3600",
    // writer 墙钟安全上限从代码缺省 25 提到 40:C7 纵切规格的 writer 在 25min 钳制下
    // 三连 exit 55(每轮精确 ~25min20s,task 0c4a7281 取证),25min 装不下纵切量级。
    "MAX_WRITER_WALL_MINUTES": "40",
    "DEFAULT_MAX_ATTEMPTS": "3",
    "REJECT_EVIDENCE_MODE": "shadow",
    "BASE_PIN_MODE": "shadow",
    "EGRESS_MODE": "enforce",
    "EGRESS_GIT_HOSTS": "github.com,registry.npmjs.org",
    // Supervisor(四层可观测第②层 Observation 的独立消费者)的启用点。代码里缺省 off,
    // 必须在这里显式写 shadow 才生效 —— 「什么时候开始有东西盯着」是可审计的。
    // shadow = 只往权威事件链记 supervisor_finding,**不做任何处置**(不 cancel/kill/BLOCKED/改路由)。
    "SUPERVISOR_MODE": "shadow",
    // tick 间隔(秒):alarm 在截止驱动之外多出一条更早的节奏,使悬挂期间也能醒来判断。
    "SUPERVISOR_TICK_SECONDS": "60"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-agent",
      "database_id": "8b42f506-6bd6-4820-9267-55c0df7b1c50",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "cloud-agent-artifacts" },
    { "binding": "EVIDENCE", "bucket_name": "cloud-agent-evidence" }
  ],
  "workflows": [
    { "name": "attempt", "binding": "ATTEMPT_WORKFLOW", "class_name": "AttemptWorkflow" }
  ],
  "queues": {
    "producers": [
      { "binding": "REVIEW_QUEUE", "queue": "cloud-agent-review" },
      { "binding": "REPORT_QUEUE", "queue": "cloud-agent-report" }
    ],
    "consumers": [
      {
        "queue": "cloud-agent-review",
        "max_retries": 3,
        "dead_letter_queue": "cloud-agent-review-dlq",
        "max_batch_timeout": 5
      },
      {
        "queue": "cloud-agent-report",
        "max_retries": 3,
        "dead_letter_queue": "cloud-agent-report-dlq",
        "max_batch_timeout": 5
      }
    ]
  },
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "registry.cloudflare.com/34817bdd8eefd771f3c7ee9ef6f1a5f0/cloud-agent-sandbox:qwen-0.21.10-r1",
      "max_instances": 50,
      "instance_type": "standard-2"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "Sandbox", "class_name": "Sandbox" },
      { "name": "TASK_SESSION", "class_name": "TaskSession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v2", "new_sqlite_classes": ["TaskSession"] }
  ],
  "observability": { "enabled": true }
}
